{
  "name": "tunisia-padel-experience",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-production.mjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "estimate:packages": "node scripts/package-estimates.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --config .prettierrc.json --write . ../README.md ../AGENTS.md ../docs/PROJECT.md",
    "format:check": "prettier --config .prettierrc.json --check . ../README.md ../AGENTS.md ../docs/PROJECT.md",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build:review": "tsc -b && vite build --mode review && node scripts/verify-production.mjs --review",
    "preview:review": "vite preview --mode review"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
